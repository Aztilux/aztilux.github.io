---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import "../styles/global.css";
---

<Layout title="About Me">
    <div class="absolute w-full h-full grid grid-rows-[2fr_1fr] grid-cols-1 lg:flex items-center justify-center gap-4">
        <Card class="mt-10 lg:mt-0 w-full h-auto lg:flex-initial lg:h-auto lg:w-150">
            <h1 class="text-4xl font-bold text-white linear-wipe mb-6">Azti | About Me</h1>
            <a href="/" class="absolute right-3 top-3 text-white"><i class="material-symbols-outlined" style="font-size:40px;">arrow_back</i></a>
            <div class="max-h-110 overflow-y-auto pr-2.5 bg-gray-900/30 rounded-2xl mx-auto p-4 text-white bg-scroll lg:[scrollbar-width:none]">
                I am Azti, an IT student from Spain. I enjoy developing things in my free time and I like computers in general.<br><br>
                I really enjoy playing sandbox and simulation games. I am also a VR enthusiast.<br><br>
                I am constantly listening to music. My favourite genre is indie music but I listen to everything; please show me what you like!!<br><br>
                Feel free to add me on Discord.
            </div>
        </Card>
    </div>
</Layout>